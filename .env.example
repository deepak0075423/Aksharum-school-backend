# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# DEV / direct: point straight at Postgres (port 5432).
DATABASE_URL=postgres://erp_user:password@localhost:5432/aksharum_erp
# Per-worker pool size (auto-computed by ecosystem.config.js under PM2 cluster mode)
# PG_POOL_MAX=20

# ─── PgBouncer (transaction-pooling connection pooler) ───────────────────────
# PRODUCTION @ 5k+ users: run PgBouncer in front and flip these two lines.
# PgBouncer multiplexes all app workers onto a small pool of real Postgres
# backends, removing the "workers × pool < max_connections" ceiling.
# Setup + pool math: deploy/pgbouncer/README.md
#
#   1) Point the app at the pooler (note the 6432 port):
# DATABASE_URL=postgres://erp_user:password@127.0.0.1:6432/aksharum_erp
#   2) Tell ecosystem.config.js it's safe to size larger app→pooler pools.
#      NOTE: PM2 reads this from the SHELL env when you run `pm2 start`
#      (it is not loaded from this .env), e.g.  PGBOUNCER=true pm2 start ecosystem.config.js
# PGBOUNCER=true
#   Optional: app→pooler client-connection budget (only used when PGBOUNCER=true).
#   Sizes cheap client conns, NOT real Postgres backends. Default 400.
# PG_TOTAL_POOL=400
#   Optional: a direct (non-pooled) URL for psql/admin/one-off migrations that
#   want a raw backend instead of a transaction-pooled one.
# DIRECT_DATABASE_URL=postgres://erp_user:password@127.0.0.1:5432/aksharum_erp

# ─── Cache / Pub-Sub (Redis) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth (JWT) ──────────────────────────────────────────────────────────────
JWT_SECRET=your_strong_jwt_secret_here
JWT_REFRESH_SECRET=your_strong_refresh_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── WebSocket Gateway wiring ────────────────────────────────────────────────
# URL of the standalone Socket.io gateway; INTERNAL_SECRET must match the gateway's .env
CHAT_SERVICE_URL=http://localhost:4000
INTERNAL_SECRET=your_shared_internal_secret_here

# ─── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
APP_NAME=School Management System

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
EMAIL_FROM=School Management <noreply@example.com>

# Sign in with Google (optional). Leave both empty to hide the button.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized JavaScript origins must be the site's https domain (or http://localhost
# for development) — Google does not accept a bare IP address or plain http.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Admissions (all optional — see docs/admission-operations.md) ────────────
# ADMISSION_MAIL_DRIVER=log                # development only: log emails, send nothing
# ADMISSION_WEBHOOK_SECRET=                # signed bounce/complaint reports → /api/admission/webhooks/email-events
# ADMISSION_STORAGE=s3                     # documents in a private bucket instead of this disk
# S3_BUCKET=  S3_REGION=  S3_ACCESS_KEY_ID=  S3_SECRET_ACCESS_KEY=  S3_ENDPOINT=  S3_FORCE_PATH_STYLE=
# CAPTCHA_PROVIDER=turnstile               # turnstile | hcaptcha
# CAPTCHA_SITE_KEY=  CAPTCHA_SECRET=
# CLAMAV_HOST=127.0.0.1                    # virus-scan uploads with clamd
# CLAMAV_PORT=3310  CLAMAV_REQUIRED=false  CLAMAV_TIMEOUT_MS=15000
# DIGILOCKER_CLIENT_ID=  DIGILOCKER_CLIENT_SECRET=
# DIGILOCKER_REDIRECT_URI=https://api.example.com/api/admission/digilocker/callback
# APP_SCHEME=aksharum                     # the phone app's link scheme — DigiLocker returns there when started in the app
# TRUST_PROXY_HOPS=1                       # proxies in front of the API — rate limits key on the visitor's address
